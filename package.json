{
  "name": "assettracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QR/NFC asset tracking for offshore generators and other equipment, on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply assetdatabase --local",
    "db:migrate:remote": "wrangler d1 migrations apply assetdatabase --remote",
    "db:seed:local": "wrangler d1 execute assetdatabase --local --file=seed/demo.sql",
    "vendor": "node scripts/copy-vendor.mjs",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "qrcode-generator": "2.0.4",
    "wrangler": "4.154.0"
  }
}
