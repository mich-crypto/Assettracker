{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assettracker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // "open": no logins, anyone with the URL can use every screen.
    // Set to "login" to require accounts (then SESSION_SECRET and SETUP_KEY are needed).
    "AUTH_MODE": "open",
    // "on": the phone suggests the WTG / SOV from GPS (any location can still be picked,
    // and away from the wind farm the phone's own position is used).
    // "off": no GPS suggestion at all, the location is always picked by hand.
    "GEO_CHECK": "on"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assetdatabase",
      "database_id": "b9f3ef85-552c-46d1-8096-e4de9dca2031",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets, only needed when AUTH_MODE is "login" (set with `npx wrangler secret put <NAME>`):
  //   SESSION_SECRET  random string, >= 32 chars, signs login sessions
  //   SETUP_KEY       one-time key to create the first admin account
}
