{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assettracker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // "open": no logins. Access is by project link (for example /BLP); put the site
    // behind Cloudflare Access when real access control is needed.
    "AUTH_MODE": "open"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker handles the API, label redirects (/t/CODE) and project links (/BLP,
    // /BLP/field ...). Static files are served straight from the asset store.
    "run_worker_first": ["/*", "!/js/*", "!/css/*", "!/vendor/*", "!/icons/*", "!/sw.js"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assetdatabase",
      "database_id": "b9f3ef85-552c-46d1-8096-e4de9dca2031",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets, only needed when AUTH_MODE is "login" (set with `npx wrangler secret put <NAME>`):
  //   SESSION_SECRET  random string, >= 32 chars, signs login sessions
  //   SETUP_KEY       one-time key to create the first admin account
}
